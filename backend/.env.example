# For running the backend directly (uvicorn/alembic) outside Docker:
#   cp .env.example .env
# When running via `docker compose up`, the root-level .env.example is used
# instead (docker-compose.yml sets env_file: ../.env — see repo root).

ENV=local
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

DATABASE_URL=postgresql+asyncpg://finsight:finsight@localhost:5432/finsight
DATABASE_URL_SYNC=postgresql+psycopg://finsight:finsight@localhost:5432/finsight

REDIS_URL=redis://localhost:6379/0

BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

HYBRID_SEARCH_ALPHA=0.6
RETRIEVAL_TOP_K=8
RERANK_TOP_N=5

CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

MAX_UPLOAD_MB=50
UPLOAD_DIR=./data/uploads
