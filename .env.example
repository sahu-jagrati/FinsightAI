# Copy this file to `.env` in the repo root and fill in real values.
# `docker-compose.yml` loads this file for the backend + worker containers.
# Never commit the real `.env` — it's already in .gitignore.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
ENV=local
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Postgres (used to build DATABASE_URL / DATABASE_URL_SYNC in docker-compose)
# ---------------------------------------------------------------------------
POSTGRES_USER=finsight
POSTGRES_PASSWORD=finsight
POSTGRES_DB=finsight
POSTGRES_PORT=5432

# Full URLs — used directly when running the backend OUTSIDE docker compose
# (e.g. `uvicorn app.main:app --reload` from backend/ against a local Postgres).
DATABASE_URL=postgresql+asyncpg://finsight:finsight@localhost:5432/finsight
DATABASE_URL_SYNC=postgresql+psycopg://finsight:finsight@localhost:5432/finsight

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600
REDIS_RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Ports exposed on the host by docker-compose
# ---------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# ---------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# LLM provider abstraction (see backend/app/rag/llm)
# Supported: openai | anthropic | ollama | mock
# "mock" requires no key and is the default so the app runs out of the box.
# ---------------------------------------------------------------------------
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_REQUEST_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Embeddings (Hugging Face — downloaded/run locally, no API key needed)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------------------------
# Retrieval / hybrid search / reranking
# ---------------------------------------------------------------------------
HYBRID_SEARCH_ALPHA=0.6
RETRIEVAL_TOP_K=8
RERANK_TOP_N=5
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true

# ---------------------------------------------------------------------------
# Ingestion / chunking
# ---------------------------------------------------------------------------
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=50
UPLOAD_DIR=./data/uploads
